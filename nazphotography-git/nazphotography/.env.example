# Firebase (Firestore) — required for booking & contact form submissions to save.
# Create a project at https://console.firebase.google.com, enable Firestore,
# then copy the web app config values here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cloudinary — only needed if you migrate images off /public (see lib/cloudinary.ts).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# WhatsApp number used by the WhatsApp button and contact fallback (digits only,
# country code first, no + or spaces). Falls back to a placeholder if unset.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Booking notifications — Apps Script Web App URL from apps-script/booking-notify.gs
# (see README "Booking notifications & deposit payment"). Optional: bookings still
# save to Firestore without this, you just won't get emailed about them.
NEXT_PUBLIC_BOOKING_NOTIFY_URL=
# Must match SHARED_SECRET in the Apps Script file. Note this ships in the client
# bundle like any NEXT_PUBLIC_* var — it deters casual abuse of the public Apps
# Script URL, it isn't a real secret.
NEXT_PUBLIC_BOOKING_NOTIFY_SECRET=
